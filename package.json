{
  "name": "spamcha",
  "version": "0.9.5",
  "description": "Juez de spam local para formularios web — Bayes + reglas declarativas, cero dependencias de runtime, tu contenido nunca sale de tu servidor",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "spamcha": "./dist/cli.js"
  },
  "files": [
    "dist",
    "integrations/wordpress",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "demo": "tsc && node dist/demo.js"
  },
  "keywords": [
    "spam",
    "antispam",
    "forms",
    "bayes",
    "classifier",
    "self-hosted",
    "local",
    "privacy"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  },
  "homepage": "https://github.com/kinti/spamcha#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinti/spamcha.git"
  },
  "bugs": {
    "url": "https://github.com/kinti/spamcha/issues"
  }
}
